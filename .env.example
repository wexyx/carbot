# Startup-only configuration. Copy to ~/.carbot/.agent.env (or an instance directory).
# A launch-directory .agent.env overrides instance defaults. Literal KEY=value, not shell code.
# Default: ~/.carbot (omit to use the user home directory)
# CARBOT_DATA_DIR=/absolute/path/to/instance
BIND_ADDR=127.0.0.1:8787
AGENT_MODE=agent
ADMIN_AGENT_PROVIDER=carbot
MODEL_PROVIDER=deepseek
MODEL_NAME=your-tool-capable-model
MODEL_API_KEY=your-model-service-key
# MODEL_BASE_URL=https://model.example/v1
# MODEL_API=chat
# Default workdir: user home directory
# AGENT_WORKDIR=/absolute/workdir
AGENT_OUTSIDE_ACCESS=deny
# WEB_CONFIG_ORIGINS=https://config.example.com,http://localhost:5173
# Optional native Python execution. Skills also require a per-skill execution grant.
# CARBOT_ALLOW_SKILL_PYTHON=1
# AGENT_PYTHON_BIN=/absolute/path/to/python3
# CARBOT_SANDBOX_PROFILES_JSON=[{"id":"default","network":"host","timeout_seconds":30}]
# CARBOT_SANDBOX_PROFILE=default
# CARBOT_SANDBOX_ALLOWED_PROFILES=default
