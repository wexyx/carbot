#!/usr/bin/env bash
set -euo pipefail
invocation_dir=$PWD
source_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
cd "$source_dir"

usage() {
  printf '%s\n' 'agent-node [start|run|proxy] [--cli] [--name ALIAS] [--server-port PORT] [--workdir PATH] [--outside-access ask|deny]' 'carbot [--workdir PATH] [--outside-access ask|deny]' '管理操作请直接与默认 Agent 对话。启动配置使用环境变量或 .agent.env。'
}
# Data, never shell code. Exported environment wins; later config files override earlier files.
loaded_keys=''
for file in .env .carbot.env .agent.env .node.env; do
  [[ -f $file ]] || continue
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == *=* && $line != \#* ]] || continue
    key=${line%%=*}; value=${line#*=}; value=${value%$'\r'}
    case "$key" in
      CARBOT_DATA_DIR|BIND_ADDR|AGENT_MODE|AGENT_NAME|AGENT_PROVIDER|ADMIN_AGENT_PROVIDER|AGENT_WORKDIR|AGENT_OUTSIDE_ACCESS|AGENT_PYTHON_BIN|MODEL_PROVIDER|MODEL_NAME|MODEL_API_KEY|MODEL_BASE_URL|MODEL_API|WEB_CONFIG_ORIGINS|WEB_CONFIG_DIR|CARBOT_ALLOW_SKILL_PYTHON|CARBOT_SANDBOX_PROFILES_JSON|CARBOT_SANDBOX_PROFILE|CARBOT_SANDBOX_ALLOWED_PROFILES|NODE_LINKS_JSON|CODEX_BIN|CLAUDE_BIN)
        if printenv "$key" >/dev/null 2>&1 && [[ " $loaded_keys " != *" $key "* ]]; then continue; fi
        export "$key=$value"; loaded_keys="$loaded_keys $key" ;;
    esac
  done < "$file"
done
export CARBOT_CONFIG_DEFAULT_KEYS="$loaded_keys"
command_name=start
if [[ $# -gt 0 && $1 != --* ]]; then command_name=$1; shift; fi
case "$command_name" in
  start|run) ;;
  proxy) export AGENT_MODE=proxy ;;
  help|-h) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac
startup_args=()
interactive=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --cli) interactive=true; startup_args+=(--cli); shift ;;
    --name|--server-port|--web-port)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      startup_args+=("$1" "$2"); shift 2 ;;
    --data-dir)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      directory=$2; [[ $directory == /* ]] || directory="$invocation_dir/$directory"
      startup_args+=(--data-dir "$directory"); shift 2 ;;
    --workdir)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      directory=$2; [[ $directory == /* ]] || directory="$invocation_dir/$directory"
      startup_args+=(--workdir "$directory"); shift 2 ;;
    --outside-access)
      [[ $# -ge 2 && ( $2 == ask || $2 == deny ) ]] || { usage >&2; exit 2; }
      startup_args+=(--outside-access "$2"); shift 2 ;;
    --help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
export AGENT_WORKDIR=${AGENT_WORKDIR:-$invocation_dir}
export CARBOT_DATA_DIR=${CARBOT_DATA_DIR:-$invocation_dir/.carbot}
[[ $AGENT_WORKDIR == /* ]] || export AGENT_WORKDIR="$invocation_dir/$AGENT_WORKDIR"
[[ $CARBOT_DATA_DIR == /* ]] || export CARBOT_DATA_DIR="$invocation_dir/$CARBOT_DATA_DIR"
export WEB_CONFIG_DIR=${WEB_CONFIG_DIR:-$source_dir/apps/web/dist}
if [[ $interactive == false && ! -f $WEB_CONFIG_DIR/index.html ]]; then
  command -v pnpm >/dev/null || { printf '请先 pnpm install && pnpm web:build，或指定 WEB_CONFIG_DIR。\n' >&2; exit 1; }
  pnpm web:build
fi
if command -v cargo >/dev/null; then
  exec cargo run -p agent-node --bin agent-node -- ${startup_args[@]+"${startup_args[@]}"}
fi
for binary in target/release/agent-node target/debug/agent-node; do
  if [[ -x $binary ]]; then exec "$binary" ${startup_args[@]+"${startup_args[@]}"}; fi
done
printf '未找到 Rust cargo 或已编译的 agent-node。\n' >&2
exit 1
